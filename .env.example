# Copy to .env and fill in what you have. Everything is optional.

# Which translator to use: auto | ollama | claude | rules
#   auto = Ollama if it's running, else Claude if a key is set, else the offline rule-based fallback
LLM=auto

# Local LLM (https://ollama.com): install it, run `ollama pull llama3.2`, keep the app running
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Tip: a vision model (e.g. OLLAMA_MODEL=llama3.2-vision or gemma3) lets Ollama *see* tapped objects too

# Claude (https://console.anthropic.com). Also sees tapped objects for precise descriptions.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ElevenLabs voice (https://elevenlabs.io). Without a key the browser's best female voice is used.
# eleven_v3 performs emotion tags like [excited] or [sighs]; if your plan lacks it, the app falls back to
# eleven_multilingual_v2 automatically. Default voice: Sarah (female). Others can be picked in the app.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_v3

PORT=5173
